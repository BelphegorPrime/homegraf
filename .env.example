# The knobs of the stack. ./setup.sh writes the real .env (with random secrets); this file only documents it.

# --- who and where -----------------------------------------------------------------------------------------------------
# The address of this host in your LAN. The wildcard DNS entry and the proxy hosts point at it.
HOST_IP=192.168.1.10
# How names reach this host (the proxy routes by name, so they must):
#   technitium  Technitium DNS Server runs in this stack (profile "technitium", the default): the bootstrap makes the zone, the wildcard
#               *.${DOMAIN} -> ${HOST_IP} and an API token for the tools; setup.sh also sets COMPOSE_PROFILES and DNS_BIND below.
#               Needs port 53 on HOST_IP free; point your router's DHCP at HOST_IP. Android's private DNS wants two DNS servers.
#   adguard     AdGuard Home runs in this stack (profile "dns"); same port, same router step. Never both.
#   external    you already have DNS: create the wildcard entry  *.${DOMAIN} -> ${HOST_IP}  there
#   sslip       zero configuration, for trying it out: DOMAIN is <HOST_IP with dashes>.sslip.io, answered by a public service
DNS_MODE=technitium
# Services are reached as <name>.${DOMAIN}: git, komodo, secrets, proxy, homegraf.
DOMAIN=192-168-1-10.sslip.io
# The sign-in name of homegraf, Komodo, Nginx Proxy Manager, Infisical and AdGuard Home: your e-mail address (setup.sh writes it twice).
ADMIN_USER=admin@homegraf.lan
ADMIN_EMAIL=admin@homegraf.lan
# Forgejo's user name owns the repository, so it is a plain name (no "@", not "admin"); you sign in there with ADMIN_EMAIL too.
FORGEJO_ADMIN_USER=owner
# The password of all of them.
# 14 characters or more with a letter and a digit (Infisical's policy).
ADMIN_PASSWORD=
# Absolute path: Komodo's agent must see its root directory under the same path inside and outside its container.
DATA_DIR=/srv/homegraf/data
TZ=Etc/UTC

# --- ports on this host (change them to run next to other things) -------------------------------------------------------
BIND_ADDRESS=0.0.0.0
PORT_HTTP=80
PORT_HTTPS=443
PORT_NPM_ADMIN=81
PORT_FORGEJO=3000
PORT_FORGEJO_SSH=2222
PORT_KOMODO=9120
PORT_INFISICAL=8079
PORT_HOMEGRAF=8097
# Only with DNS_MODE=technitium or adguard: DNS on the LAN address (53 is the only port clients can use), AdGuard's first-run setup page
# (not Technitium), the admin UI/console of either. Technitium forwards what it does not know to DNS_FORWARDERS.
# DNS_BIND is set by setup.sh to HOST_IP: bound there only, systemd-resolved (127.0.0.53:53) does not collide.
PORT_DNS=53
PORT_DNS_SETUP=3300
PORT_DNS_ADMIN=8053
# DNS_BIND=192.168.1.10
# DNS_FORWARDERS=1.1.1.1,9.9.9.9
# Optional services, comma separated (setup.sh asks, or OPTIONAL_SERVICES="renovate backup" ./setup.sh):
#   dns (AdGuard Home), renovate (needs the runner, which it starts), runner, backup, status (Uptime Kuma)
# COMPOSE_PROFILES=dns,renovate
# The secret the Actions runner and Forgejo share (40 hexadecimal characters; setup.sh writes one).
# RUNNER_SECRET=
# Prefix of the container names, so that a second stack can live on the same host.
PROJECT_PREFIX=homegraf

# --- images and the repository homegraf reads ---------------------------------------------------------------------------
# Public once the project is, until then `docker login ghcr.io` or build app/ yourself and name it here.
HOMEGRAF_IMAGE=ghcr.io/belphegorprime/homegraf:main
# The bootstrap image; like HOMEGRAF_IMAGE private until the project is public (docker login ghcr.io, or build bootstrap/ yourself).
BOOTSTRAP_IMAGE=ghcr.io/belphegorprime/homegraf-bootstrap:main
# What homegraf reads at /repo: by default Komodo's clone of your repository, <DATA_DIR>/periphery/repos/infrastructure.
# Set it to point at a checkout of your own.
# REPO_DIR=

# --- generated by setup.sh: secrets of the services ----------------------------------------------------------------------
FORGEJO_DB_PASSWORD=
FORGEJO_SECRET_KEY=
KOMODO_DB_PASSWORD=
KOMODO_PASSKEY=
KOMODO_JWT_SECRET=
KOMODO_WEBHOOK_SECRET=
INFISICAL_DB_PASSWORD=
INFISICAL_ENCRYPTION_KEY=
INFISICAL_AUTH_SECRET=

# --- what homegraf needs for live status and the write actions: the bootstrap writes it to /state/homegraf.env, homegraf reads it at start.
# Set a value here only to override that (the environment wins over the file). ------------------------------------------------
KOMODO_API_KEY=
KOMODO_API_SECRET=
HOMEGRAF_CLONE_URL=
FORGEJO_TOKEN=
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=

# --- optional hardware layer: leave empty and homegraf has no Network tab ---------------------------------------------------
UNIFI_URL=
UNIFI_USER=
UNIFI_PASSWORD=
# SHA-256 of the controller's certificate (it is self-signed); empty = not verified
UNIFI_FINGERPRINT=
