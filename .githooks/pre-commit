#!/usr/bin/env bash
# Formatting and lint of what is staged under app/ (the same checks as the pipeline, on the changed files only).
# Turned on by `npm ci` in app/ (git config core.hooksPath .githooks); skip once with `git commit --no-verify`.
set -euo pipefail
root=$(git rev-parse --show-toplevel)
cd "$root/app"

mapfile -t staged < <(git diff --cached --name-only --diff-filter=ACMR -z -- . | xargs -0 -n1 | sed 's|^app/||')
[ ${#staged[@]} -eq 0 ] && exit 0

if ! npx --no-install prettier --check --ignore-unknown --log-level warn "${staged[@]}"; then
  echo "pre-commit: not formatted. Run 'cd app && npm run format', add the files and commit again." >&2
  exit 1
fi

mapfile -t code < <(printf '%s\n' "${staged[@]}" | grep -E '\.(ts|tsx)$' || true)
[ ${#code[@]} -eq 0 ] || npx --no-install oxlint --deny-warnings "${code[@]}"
