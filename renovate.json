{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits"],
  "labels": ["renovate"],
  "dependencyDashboard": {
    "enabled": true
  },
  "configMigration": true,
  "timezone": "Europe/Berlin",
  "schedule": ["before 6am on monday"],
  "vulnerabilityAlerts": {
    "schedule": ["at any time"],
    "labels": ["renovate", "security"]
  },
  "automerge": false,
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "github-actions": {
    "managerFilePatterns": ["/(^|/)\\.github/workflows/[^/]+\\.ya?ml$/", "/(^|/)\\.forgejo/workflows/[^/]+\\.ya?ml$/"]
  },
  "docker-compose": {
    "managerFilePatterns": ["/(^|/)(?:docker-)?compose[^/]*\\.ya?ml$/", "/(^|/)[^/]+\\.compose\\.ya?ml$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Versions pinned in scripts with a '# renovate:' comment",
      "managerFilePatterns": ["/(^|/)compose-wrap\\.sh$/"],
      "matchStrings": ["#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*\\n\\s*\\w+=(?<currentValue>\\S+)"]
    }
  ],
  "packageRules": [
    {
      "description": "One grouped pull request per week and manager for non-major updates",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest", "lockFileMaintenance"],
      "groupName": "{{manager}} non-major"
    },
    {
      "description": "Major updates are never grouped",
      "matchUpdateTypes": ["major"],
      "groupName": null
    },
    {
      "description": "Database major updates need the migration procedure",
      "matchUpdateTypes": ["major"],
      "matchPackageNames": ["/(^|/)(postgres|postgresql|mariadb|mysql|mongo|mongodb|redis|valkey)$/"],
      "addLabels": ["db-major"]
    }
  ]
}
